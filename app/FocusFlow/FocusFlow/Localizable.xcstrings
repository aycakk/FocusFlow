    "%@ · %lld min": {
      "comment": "Displays the theme and estimated time for a task.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld min"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld dk"
          }
        }
      }
    },
    "%lld": {
      "comment": "A count of the number of tasks that have been marked as completed.",
      "isCommentAutoGenerated": true
    },
    "%lld min": {
      "comment": "A small label displaying the estimated time required to complete a task. The single argument is the estimated time in minutes.",
